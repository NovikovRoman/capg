package db

import (
	"bytes"
	"context"
	"database/sql"
	"errors"
	"fmt"
	"reflect"
	"strings"
	"time"
	"unicode"
	"unicode/utf8"

	"github.com/jmoiron/sqlx"
	"github.com/jmoiron/sqlx/reflectx"
	"github.com/lib/pq"
)

type IDType interface {
	int | int32 | int64 | string
}

type SimpleBaseEntity[T IDType] interface {
	GetID() T
}

type BaseEntity[T IDType] interface {
	SimpleBaseEntity[T]

	GetCreatedAt() time.Time
	GetUpdatedAt() time.Time
	GetDeletedAt() *time.Time
}

const (
	tagName          = "db"
	tagReadOnly      = "readonly"
	tagAutoincrement = "autoincrement"
	tagConflict      = "conflict"
)

// quoteTableName accepts one unqualified PostgreSQL identifier, not SQL or a schema-qualified name.
func quoteTableName(table string) (string, error) {
	if table == "" || len(table) > 63 || !utf8.ValidString(table) {
		return "", fmt.Errorf("invalid table name %q: expected one identifier of at most 63 bytes", table)
	}
	for i, r := range table {
		if r != '_' && !unicode.IsLetter(r) && (i == 0 || !unicode.IsDigit(r)) {
			return "", fmt.Errorf("invalid table name %q: schema-qualified names and SQL expressions are not supported", table)
		}
	}
	return pq.QuoteIdentifier(table), nil
}

func structValue(ent any, writable bool) (reflect.Value, error) {
	v := reflect.ValueOf(ent)
	if !v.IsValid() {
		return reflect.Value{}, errors.New("entity is nil")
	}
	if v.Kind() == reflect.Pointer {
		if v.IsNil() {
			return reflect.Value{}, errors.New("entity is a nil pointer")
		}
		v = v.Elem()
	} else if writable {
		return reflect.Value{}, errors.New("entity must be a non-nil pointer to a struct")
	}
	if v.Kind() != reflect.Struct {
		return reflect.Value{}, errors.New("entity must be a struct or pointer to a struct")
	}
	return v, nil
}

func writableField(ent any, name string, expected reflect.Type) (reflect.Value, error) {
	v, err := structValue(ent, true)
	if err != nil {
		return reflect.Value{}, err
	}
	info, ok := v.Type().FieldByName(name)
	if !ok {
		return reflect.Value{}, fmt.Errorf("entity field %s is missing", name)
	}
	field, err := v.FieldByIndexErr(info.Index)
	if err != nil {
		return reflect.Value{}, fmt.Errorf("entity field %s: %w", name, err)
	}
	if !field.CanSet() {
		return reflect.Value{}, fmt.Errorf("entity field %s is not writable", name)
	}
	if expected != nil && field.Type() != expected {
		return reflect.Value{}, fmt.Errorf("entity field %s has type %s, expected %s", name, field.Type(), expected)
	}
	return field, nil
}

func emptyID[T IDType](ent SimpleBaseEntity[T]) bool {
	id := ent.GetID()
	switch v := any(id).(type) {
	case string:
		return v == ""
	case int:
		return v <= 0
	case int32:
		return v <= 0
	case int64:
		return v <= 0
	}
	return true
}

// Save saves the record to the DB.
//
// New record - creates in a DB, existing - updates in a DB. If the entry:
//
//   - SimpleBaseEntity regular update of a record in the DB.
//
//   - BaseEntity regular update of the record in the DB and the auto-update of the date
//     in the UpdatedAt field.
func Save[T IDType](ctx context.Context, db *sqlx.DB, table string, ent SimpleBaseEntity[T]) (err error) {
	if db == nil {
		return errors.New("database is nil")
	}
	if _, err := structValue(ent, true); err != nil {
		return err
	}
	quotedTable, err := quoteTableName(table)
	if err != nil {
		return err
	}
	if emptyID(ent) {
		return Create(ctx, db, table, ent)
	}

	if v, ok := ent.(BaseEntity[T]); ok {
		if err := setEntityField(v, "UpdatedAt", time.Now().UTC()); err != nil {
			return err
		}
	}

	set := fieldsForUpdate(ent)
	if set == "" {
		return errors.New("no fields to update")
	}
	query := "UPDATE " + quotedTable + " SET " + set + " WHERE id=:id"
	if _, ok := ent.(BaseEntity[T]); ok {
		query += " AND deleted_at IS NULL"
	}
	result, err := db.NamedExecContext(ctx, query, ent)
	if err != nil {
		return err
	}
	affected, err := result.RowsAffected()
	if err != nil {
		return err
	}
	if affected == 0 {
		return sql.ErrNoRows
	}
	return nil
}

func SaveOrUpdateT[T any](ctx context.Context, db *sqlx.DB, table string, ent T) error {
	if db == nil {
		return errors.New("database is nil")
	}
	if _, err := structValue(ent, false); err != nil {
		return err
	}
	quotedTable, err := quoteTableName(table)
	if err != nil {
		return err
	}
	conflicts := conflictFields(ent)
	if len(conflicts) == 0 {
		return errors.New("conflict fields not found")
	}

	fields := TableFields(ent, true)
	if len(fields) == 0 {
		return errors.New("no table fields found")
	}

	conflictSet := make(map[string]bool, len(conflicts))
	quotedConflicts := make([]string, len(conflicts))
	for i, c := range conflicts {
		conflictSet[c] = true
		quotedConflicts[i] = pq.QuoteIdentifier(c)
	}

	set := make([]string, len(fields))
	values := make([]string, len(fields))
	updated := make([]string, 0, len(fields))

	for i, name := range fields {
		set[i] = pq.QuoteIdentifier(name)
		values[i] = ":" + name
		if !conflictSet[name] {
			updated = append(updated, pq.QuoteIdentifier(name)+"=EXCLUDED."+pq.QuoteIdentifier(name))
		}
	}

	if len(updated) == 0 {
		return errors.New("no fields to update after excluding conflict fields")
	}

	query := `INSERT INTO ` + quotedTable + ` (` + strings.Join(set, ",") + `) VALUES (` + strings.Join(values, ",") + `)
    ON CONFLICT (` + strings.Join(quotedConflicts, ",") + `)
    DO UPDATE SET ` + strings.Join(updated, ",")

	_, err = db.NamedExecContext(ctx, query, ent)
	return err
}

func SaveT[T any](ctx context.Context, db *sqlx.DB, table string, ent T) (bool, error) {
	if db == nil {
		return false, errors.New("database is nil")
	}
	if _, err := structValue(ent, false); err != nil {
		return false, err
	}
	quotedTable, err := quoteTableName(table)
	if err != nil {
		return false, err
	}
	set, values := FieldsForInsert(ent)
	query := "INSERT INTO " + quotedTable
	if set == "" {
		query += " DEFAULT VALUES"
	} else {
		query += " (" + set + ") VALUES (" + values + ")"
	}
	query += " ON CONFLICT DO NOTHING"
	res, err := db.NamedExecContext(ctx, query, ent)
	if err != nil {
		return false, err
	}
	n, err := res.RowsAffected()
	return n > 0, err
}

func SaveMany[T any](ctx context.Context, db *sqlx.DB, table string, items []T, conflictDoNothing bool) error {
	quotedTable, err := quoteTableName(table)
	if err != nil {
		return err
	}
	if len(items) == 0 {
		return nil
	}
	if db == nil {
		return errors.New("database is nil")
	}
	if _, err := structValue(items[0], false); err != nil {
		return fmt.Errorf("item 0: %w", err)
	}
	names := TableFields(items[0], true)
	if len(names) == 0 {
		return errors.New("no insertable fields for bulk insert")
	}
	b := bytes.Repeat([]byte("?,"), len(names))
	values := strings.Repeat("("+string(b[:len(b)-1])+"),", len(items))
	args := make([]any, len(items)*len(names))
	for i, c := range items {
		if _, err := structValue(c, false); err != nil {
			return fmt.Errorf("item %d: %w", i, err)
		}
		for ii, name := range names {
			value, ok := fieldValueByDBTag(c, name)
			if !ok {
				return fmt.Errorf("item %d: field %s is not accessible", i, name)
			}
			args[i*len(names)+ii] = value
		}
	}
	values = strings.TrimRight(values, ",")
	quotedNames := make([]string, len(names))
	for i, name := range names {
		quotedNames[i] = pq.QuoteIdentifier(name)
	}
	query := "INSERT INTO " + quotedTable + " (" + strings.Join(quotedNames, ",") + ") VALUES " + values
	if conflictDoNothing {
		query += " ON CONFLICT DO NOTHING"
	}
	_, err = db.ExecContext(ctx, db.Rebind(query), args...)
	return err
}

// Create creates a record in the DB.
//
// If the entry:
//
//   - SimpleBaseEntity the usual creation of a record in the DB.
//
//   - BaseEntity the usual creation of a record in the DB, setting CreatedAt to the current time,
//     UpdatedAt if not set - to the current time, DeletedAt if not set - nil.
func Create[T IDType](ctx context.Context, db *sqlx.DB, table string, ent SimpleBaseEntity[T]) (err error) {
	if db == nil {
		return errors.New("database is nil")
	}
	if _, err := structValue(ent, true); err != nil {
		return err
	}
	quotedTable, err := quoteTableName(table)
	if err != nil {
		return err
	}
	if !emptyID(ent) {
		return Save(ctx, db, table, ent)
	}

	if vEnt, ok := ent.(BaseEntity[T]); ok {
		if vEnt.GetCreatedAt().IsZero() {
			if err := setEntityField(vEnt, "CreatedAt", time.Now().UTC()); err != nil {
				return err
			}
		}
		if vEnt.GetUpdatedAt().IsZero() {
			if err := setEntityField(vEnt, "UpdatedAt", time.Now().UTC()); err != nil {
				return err
			}
		}
		if vEnt.GetDeletedAt() != nil && vEnt.GetDeletedAt().IsZero() {
			if err := setEntityField(vEnt, "DeletedAt", (*time.Time)(nil)); err != nil {
				return err
			}
		}
	}

	set, values := FieldsForInsert(ent)
	nameID, dbNameID := FindAutoincrement(ent)
	var idField reflect.Value
	if nameID != "" {
		if dbNameID == "" {
			return fmt.Errorf("autoincrement field %s has no db tag", nameID)
		}
		idField, err = writableField(ent, nameID, nil)
		if err != nil {
			return err
		}
		if idField.Kind() != reflect.Int && idField.Kind() != reflect.Int32 && idField.Kind() != reflect.Int64 && idField.Kind() != reflect.String {
			return fmt.Errorf("unsupported autoincrement field %s of type %s", nameID, idField.Type())
		}
	}
	query := "INSERT INTO " + quotedTable
	if set == "" {
		query += " DEFAULT VALUES"
	} else {
		query += " (" + set + ") VALUES (" + values + ")"
	}
	if nameID == "" {
		_, err = db.NamedExecContext(ctx, query, ent)
		return
	}

	query += " RETURNING " + pq.QuoteIdentifier(dbNameID)
	boundQuery, args, err := db.BindNamed(query, ent)
	if err != nil {
		return err
	}
	rows, err := db.QueryxContext(ctx, boundQuery, args...)
	if err != nil {
		return err
	}
	defer func() {
		_ = rows.Close()
	}()
	if !rows.Next() {
		if err = rows.Err(); err == nil {
			err = errors.New("insert returned no ID")
		}
		return
	}
	return rows.Scan(idField.Addr().Interface())
}

func setEntityField(ent any, name string, value any) error {
	v := reflect.ValueOf(value)
	field, err := writableField(ent, name, v.Type())
	if err != nil {
		return err
	}
	field.Set(v)
	return nil
}

func FieldsForInsert(ent any) (set string, values string) {
	for i, name := range TableFields(ent, true) {
		if i > 0 {
			set += ","
			values += ","
		}
		set += pq.QuoteIdentifier(name)
		values += ":" + name
	}
	return
}

func fieldsForUpdate(ent any) (set string) {
	for i, name := range TableFields(ent, false) {
		if i > 0 {
			set += ","
		}
		set += pq.QuoteIdentifier(name) + "=:" + name
	}
	return
}

func TableFields(ent any, forInsert bool) (fields []string) {
	if _, err := structValue(ent, false); err != nil {
		return nil
	}
	m := reflectx.NewMapperFunc(tagName, func(s string) string { return s })
	for _, n := range m.TypeMap(reflect.TypeOf(ent)).Names {
		if n.Field.Tag.Get(tagReadOnly) == "true" {
			continue
		}
		if forInsert && n.Field.Tag.Get(tagAutoincrement) == "true" {
			continue
		}
		if len(n.Index) == 1 {
			fields = append(fields, n.Path)
		}
	}
	return
}

func conflictFields(ent any) []string {
	if _, err := structValue(ent, false); err != nil {
		return nil
	}
	fields := []string{}
	m := reflectx.NewMapperFunc(tagName, func(s string) string { return s })
	for _, n := range m.TypeMap(reflect.TypeOf(ent)).Names {
		if n.Field.Tag.Get(tagConflict) != "true" {
			continue
		}
		if len(n.Index) == 1 {
			fields = append(fields, n.Path)
		}
	}
	return fields
}

func FindAutoincrement(ent any) (string, string) {
	if _, err := structValue(ent, false); err != nil {
		return "", ""
	}
	name := ""
	dbName := ""
	m := reflectx.NewMapperFunc(tagAutoincrement, func(s string) string { return s })
	for _, n := range m.TypeMap(reflect.TypeOf(ent)).Names {
		if n.Field.Tag.Get(tagAutoincrement) != "true" {
			continue
		}
		dbName = n.Field.Tag.Get(tagName)
		name = n.Field.Name
		break
	}
	return name, dbName
}

func fieldValueByDBTag(v any, dbTag string) (any, bool) {
	val, err := structValue(v, false)
	if err != nil {
		return nil, false
	}
	m := reflectx.NewMapperFunc(tagName, func(s string) string { return s })
	field := m.TypeMap(val.Type()).Names[dbTag]
	if field == nil || len(field.Index) != 1 {
		return nil, false
	}
	value := val.FieldByIndex(field.Index)
	if !value.CanInterface() {
		return nil, false
	}
	return value.Interface(), true
}
