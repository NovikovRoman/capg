package db

import (
	"errors"
	"strings"

	"github.com/lib/pq"
)

func IsSerializationError(err error) bool {
	if err == nil {
		return false
	}

	var pqErr *pq.Error
	if errors.As(err, &pqErr) {
		return pqErr.Code == "40001" || pqErr.Code == "40P01"
	}
	if strings.Contains(err.Error(), "could not serialize access due to read/write dependencies among") {
		return true
	}
	return false
}
